#include "imx8mp-var-dart-dt8mcustomboard.dts"

/ {
	model = "Variscite DART-MX8M-PLUS on DT8MCustomBoard 1.x";

	// gpio-keys {
	// 	pinctrl-names = "default";
	// 	pinctrl-0 = <&pinctrl_gpio_keys>;

	// 	up {
	// 		gpios = <&gpio4 18 GPIO_ACTIVE_LOW>;
	// 	};

	// 	down {
	// 		gpios = <&gpio4 15 GPIO_ACTIVE_LOW>;
	// 	};

	// 	home {
	// 		gpios = <&gpio4 13 GPIO_ACTIVE_LOW>;
	// 	};

	// 	back {
	// 		gpios = <&gpio4 6 GPIO_ACTIVE_LOW>;
	// 	};
	// };

	gpio-leds {
		status = "disabled"; 
	};

    can0_osc: can0_osc {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <20000000>;
    };
};

&i2c2 {
    ov5640_mipi0: ov5640_mipi@3c {
        /* HMI variant: camera not populated; pins are reserved for HPC/USB-C. */
        status = "disabled";

        /* Avoid dtc errors: legacy pinctrl groups are not used in this variant. */
        /delete-property/ pinctrl-names;
        /delete-property/ pinctrl-0;
        /delete-property/ powerdown-gpios;
        /delete-property/ reset-gpios;
    };
	/* Touchscreen driver */
	ilitek_ts: ilitek_ts@41 {
		compatible = "ilitek,ili2130";
		reg = <0x41>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_captouch>;

		reset-gpios = <&gpio3 19 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio4>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;

		//touchscreen-inverted-y;
		//touchscreen-inverted-x;
		wakeup-source;

		status = "okay";
	};
};

&i2c4 {
    ov5640_mipi1: ov5640_mipi@3c {
        /* HMI variant: camera not populated; pins are reserved for HPC/USB-C. */
        status = "disabled";

        /* Avoid dtc errors: legacy pinctrl groups are not used in this variant. */
        /delete-property/ pinctrl-names;
        /delete-property/ pinctrl-0;
        /delete-property/ powerdown-gpios;
        /delete-property/ reset-gpios;
    };

	/* DS1337 RTC module */
	rtc@68 {
		compatible = "dallas,ds1337";
		reg = <0x68>;
		status = "okay";
	};
};


&ldo4 {
	/* HMI variant: NVCC_SAI1_SAI5 must be 3.3V*/
    regulator-min-microvolt = <3300000>;
    regulator-max-microvolt = <3300000>;
    regulator-boot-on;
    regulator-always-on;
};

&pca6408_1 {
	status = "disabled";
};

&pca6408_2 {
	status = "disabled";
};

&pcie {
	    /* HMI variant: PCIe not used; GPIO4_IO07 is reserved for /HPC4_FAULT. */
    status = "disabled";
    /delete-property/ reset-gpio;
    /delete-property/ pinctrl-names;
    /delete-property/ pinctrl-0;
};

&can0 {
	/delete-property/ microchip,rx-int-gpios;
};

&gpio1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hdmi>;

	hdmi_on_hog {
		gpio-hog;
		gpios = <5 0>;
		output-low;
		line-name = "hdmi_on";
	};
};

&eqos {
	mdio {
		/delete-node/ ethernet-phy@1;
	};
};

&fec {
	/delete-property/ phy-handle;
	status = "disabled";
};

&iomuxc {

    pinctrl_hpc: hpcgrp {
        fsl,pins = <
            MX8MP_IOMUXC_SAI1_RXD2__GPIO4_IO04  0x1c6  /* /HPC3_CONN */
            MX8MP_IOMUXC_SAI1_RXD4__GPIO4_IO06  0x1c6  /* /HPC3_FAULT */
            MX8MP_IOMUXC_SAI1_TXFS__GPIO4_IO10  0x1c6  /* HPC3_EN */

            MX8MP_IOMUXC_SAI1_TXD1__GPIO4_IO13  0x1c6  /* /HPC4_CONN */
            MX8MP_IOMUXC_SAI1_RXD5__GPIO4_IO07  0x1c6  /* /HPC4_FAULT */
            MX8MP_IOMUXC_SAI1_RXD7__GPIO4_IO09  0x1c6  /* HPC4_EN */
        >;
    };
	pinctrl_captouch: captouchgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI1_RXD3__GPIO4_IO05 				0x1c6
			MX8MP_IOMUXC_GPIO1_IO14__GPIO1_IO14				0x16
		>;
	};

	pinctrl_can: cangrp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06				0x1c6
		>;
	};
	pinctrl_hdmi: hdmigrp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO05__GPIO1_IO05				0xc0
		>;
	};
};

/* Apply at boot */
&iomuxc {
    pinctrl-0 = <&pinctrl_hog &pinctrl_hpc>;
};

&i2c4 {
    clock-frequency = <100000>;
};
/ {
    gpio-keys {
        /* Disabled in HMI variant: base DT defines these keys via PCA(L)6408 expander,
         * but HMI spec does not include that expander or these keys.
         */
        status = "disabled";
    };
};